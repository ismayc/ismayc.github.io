**/*.quarto_ipynb

# The rendered site. CI (quarto-netlify.yaml) renders it from source on every
# deploy and publishes that build to Netlify and GitHub Pages, so a committed
# copy is never served. Untracked November 26, 2026; a clean render reproduces
# every file that was tracked here.
/docs/*
# Kept tracked: data files and PDFs that course material may fetch by a raw
# GitHub URL under docs/. The repo-root copies are what the site serves, and a
# local render copies them here, so commit both when one changes.
!/docs/cc_full.csv
!/docs/cleSac.txt
!/docs/critical_thinking_framework.pdf
!/docs/dem_score.csv
!/docs/dem_score.xlsx
!/docs/global13sdss_0.sav
!/docs/imf_data.rds
!/docs/le_mess.csv
!/docs/periodic-table-data.csv
!/docs/pnwflights23.xlsx
!/docs/spotify_dataset.csv
!/docs/wash-or_black.csv

# Python bytecode
__pycache__/
*.pyc

# Local Python virtual environments. CI builds its own in the runner's
# ~/.virtualenvs/r-reticulate, so committed copies are never used.
/venv/
/.venv/
/.virtualenvs/

# Netlify CLI state (draft deploys from the terminal)
.netlify/
